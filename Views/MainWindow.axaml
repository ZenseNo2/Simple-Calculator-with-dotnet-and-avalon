<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
        x:Class="CalculatorApp.Views.MainWindow"
        Title="Calculator"
        Width="400"
        Height="500"
        Background="#000000">
    <StackPanel Spacing="10" Margin="20">
        <TextBlock Text="Calculator" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
        
        <TextBox Text="{Binding Display, Mode=TwoWay}" 
                 FontSize="28" 
                 Margin="0,0,0,10"
                 IsReadOnly="True"
                 Background="White"
                 Foreground="Black"
                 TextAlignment="Right"
                 Height="60"/>
        
        <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="*,*,*,*,*" ColumnSpacing="10" RowSpacing="10">
            <!-- Row 1 -->
            <Button Grid.Row="0" Grid.Column="0" Content="7" Command="{Binding NumberCommand}" CommandParameter="7" />
            <Button Grid.Row="0" Grid.Column="1" Content="8" Command="{Binding NumberCommand}" CommandParameter="8" />
            <Button Grid.Row="0" Grid.Column="2" Content="9" Command="{Binding NumberCommand}" CommandParameter="9" />
            <Button Grid.Row="0" Grid.Column="3" Content="/" Command="{Binding OperatorCommand}" CommandParameter="/" Background="#ff9800" Foreground="White" />
            
            <!-- Row 2 -->
            <Button Grid.Row="1" Grid.Column="0" Content="4" Command="{Binding NumberCommand}" CommandParameter="4" />
            <Button Grid.Row="1" Grid.Column="1" Content="5" Command="{Binding NumberCommand}" CommandParameter="5" />
            <Button Grid.Row="1" Grid.Column="2" Content="6" Command="{Binding NumberCommand}" CommandParameter="6" />
            <Button Grid.Row="1" Grid.Column="3" Content="*" Command="{Binding OperatorCommand}" CommandParameter="*" Background="#ff9800" Foreground="White" />
            
            <!-- Row 3 -->
            <Button Grid.Row="2" Grid.Column="0" Content="1" Command="{Binding NumberCommand}" CommandParameter="1" />
            <Button Grid.Row="2" Grid.Column="1" Content="2" Command="{Binding NumberCommand}" CommandParameter="2" />
            <Button Grid.Row="2" Grid.Column="2" Content="3" Command="{Binding NumberCommand}" CommandParameter="3" />
            <Button Grid.Row="2" Grid.Column="3" Content="-" Command="{Binding OperatorCommand}" CommandParameter="-" Background="#ff9800" Foreground="White" />
            
            <!-- Row 4 -->
            <Button Grid.Row="3" Grid.Column="0" Content="0" Command="{Binding NumberCommand}" CommandParameter="0" />
            <Button Grid.Row="3" Grid.Column="1" Content="." Command="{Binding NumberCommand}" CommandParameter="." />
            <Button Grid.Row="3" Grid.Column="2" Content="C" Command="{Binding ClearCommand}" Background="#f44336" Foreground="White" />
            <Button Grid.Row="3" Grid.Column="3" Content="+" Command="{Binding OperatorCommand}" CommandParameter="+" Background="#ff9800" Foreground="White" />
            
            <!-- Row 5 -->
            <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Content="=" Command="{Binding EqualsCommand}" Background="#4caf50" Foreground="White" FontSize="20" FontWeight="Bold" />
            <Button Grid.Row="4" Grid.Column="3" Content="←" Command="{Binding BackspaceCommand}" Background="#2196f3" Foreground="White" />
        </Grid>
    </StackPanel>
</Window>